# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (rahsia) - .env.example sengaja dikecualikan supaya boleh commit
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Skills vendor yang dipasang oleh `prisma init` — tiga salinan bagi kandungan
# yang sama, boleh dijana semula, dan bukan sebahagian daripada projek.
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# Backup pangkalan data — mengandungi rekod perubatan, walaupun tersulit.
/backup/
