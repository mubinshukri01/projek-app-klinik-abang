# Salin ke .env dan isi nilai sebenar.

# Sambungan pangkalan data untuk PEMBANGUNAN TEMPATAN.
#
# Docker Compose TIDAK membaca baris ini — ia membina URL sendiri daripada
# pembolehubah POSTGRES_* di bawah, menggunakan nama hos "db" dalam rangkaian
# Compose. Jadi nilai ini hanya digunakan apabila anda menjalankan
# `npm run dev` terus pada mesin anda, di mana pangkalan data berada di
# localhost dan BUKAN pada hos bernama "db".
DATABASE_URL="postgresql://klinik:GANTI_PASSWORD@localhost:5432/klinik?schema=public"

# Jana dengan: openssl rand -base64 32
SESSION_SECRET=""

# Token untuk skrin paparan TV (kiosk tanpa log masuk).
# Jana dengan: openssl rand -hex 16
KIOSK_TOKEN=""

# ── Hanya untuk docker compose (deployment on-prem) ──
POSTGRES_USER="klinik"
POSTGRES_PASSWORD=""
POSTGRES_DB="klinik"

# ── Backup (deployment on-prem) ──
# Kata laluan yang menyulitkan setiap backup. SIMPAN SALINAN DI LUAR MINI PC —
# tanpanya backup tidak boleh dipulihkan langsung.
# Jana dengan: openssl rand -base64 24
BACKUP_PASSPHRASE=""

# Jam backup harian, waktu tempatan (0-23).
BACKUP_HOUR="2"

# Berapa hari backup disimpan pada mini PC.
KEEP_DAYS="30"

# Salinan luar tapak, cth. "gdrive:klinik-backup". Kosongkan untuk melangkau.
RCLONE_REMOTE=""
